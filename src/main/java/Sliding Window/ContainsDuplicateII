//219. Contains Duplicate II - LeetCode
//TC = O(n)
//SC = O(n)
class Solution {
    public boolean containsNearbyDuplicate(int[] nums, int k) {
        int left=0;
        Set<Integer> st = new HashSet<>();
        
        for(int right=0; right<nums.length; right++){
            if(st.contains(nums[right])){
                return true;
            }
            st.add(nums[right]);
            if((right-left)>=k){
                st.remove(nums[left]);
                left++;
            }
           
        }
        return false;
    }
}
